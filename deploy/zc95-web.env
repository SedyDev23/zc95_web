# ZC95 Web Manager settings. install.sh copies this to /etc/zc95-web/zc95-web.env
# the first time only; edit that copy, then: systemctl restart zc95-web

# Address and port the web interface listens on
ZC95_WEB_HOST=0.0.0.0
ZC95_WEB_PORT=8080

# The Scripts tab can only browse folders under this one
ZC95_SCRIPTS_ROOT=/var/lib/zc95-web/scripts

# Where the saved IP / folder (settings.json) are kept
ZC95_DATA_DIR=/var/lib/zc95-web

# Optional login. Leave the password blank for no login (fine on a trusted home LAN).
ZC95_WEB_USER=zc95
ZC95_WEB_PASSWORD=
